# OpenSea API key (server-only) — https://docs.opensea.io/
OPENSEA_API_KEY=

# WalletConnect Cloud project id — https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional override (defaults to Chill Bugs contract)
NEXT_PUBLIC_CHILLBUGS_CONTRACT=0x0aa201337b430361500832d6357f788cacbd9450

# Optional public site URL for share cards (defaults to production)
NEXT_PUBLIC_SITE_URL=https://chill-bugs-museum.vercel.app
